# Copier ce fichier en .env puis remplir les valeurs
# Lu automatiquement par "docker compose".

# Clé secrète Django (générée aléatoirement). La changer déconnecte tous les utilisateurs.
DJANGO_SECRET_KEY=generer-avec: python -c "import secrets;print(secrets.token_urlsafe(50))"

# Adresses autorisées (ajoutez l'IP du PC pour un accès depuis le réseau, ex: localhost,127.0.0.1,192.168.1.20)
ALLOWED_HOSTS=localhost,127.0.0.1

# Port sur la machine
HOST_PORT=80

# Compte admin créé au PREMIER démarrage uniquement (base vide).
# Sans ADMIN_PASSWORD, un mot de passe aléatoire est généré et affiché une fois dans "docker logs billarde".
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
